# ============================================
# MENTORA ENVIRONMENT CONFIGURATION
# ============================================

# -------------------------
# DATABASE
# -------------------------

DB_URL=jdbc:mysql://localhost:3306/mentora
DB_USERNAME=root
DB_PASSWORD=879879

# Keep validate as the safe default.
# For FIRST local schema initialization only,
# the developer may intentionally change this to update.
DB_DDL_AUTO=validate

# -------------------------
# JWT
# -------------------------

# Must be a strong Base64-compatible secret
# satisfying the existing JwtService requirements.
JWT_SECRET=YOUR_BASE64_JWT_SECRET

JWT_EXPIRATION_MS=3600000

# -------------------------
# CORS / SERVER
# -------------------------

CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080

# -------------------------
# GEMINI
# -------------------------

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

# -------------------------
# FRONTEND
# -------------------------

VITE_API_BASE_URL=http://localhost:8080/api
